# ============================================================
# 复制本文件为 .env 再填自己的值：  cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。
# ============================================================

# 服务端口（本地默认 3000；Render 会注入自己的 PORT，不要写死）
PORT=3000

# SQLite 数据库文件路径（相对仓库根目录）
DB_FILE=data/app.db

# DeepSeek 开放平台 Key（https://platform.deepseek.com/api_keys）
# 注意：没有 Key 时服务会自动进入「离线演示模式」，功能可跑、模型是规则模拟的
DEEPSEEK_API_KEY=

# 模型名：工具调用请用 deepseek-chat，不要用 reasoner
DEEPSEEK_MODEL=deepseek-chat

# 接口地址（一般不用改，走官方 OpenAI 兼容协议）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 允许跨域的前端来源，逗号分隔。本地 3000/5173 + 你的线上前端域名
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 保留几轮对话上下文（1 轮 = 用户 + 助手各一条）
HISTORY_LIMIT=8

# 生产环境设为 production：会关掉 ?fail=1 这个仅供联调演示的开关
NODE_ENV=development
